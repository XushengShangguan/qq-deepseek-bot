# ---- Model provider ----
# deepseek | claude | mock (no API, echoes back; for testing)
LLM_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_API_KEY=sk-****
# DEEPSEEK_MODEL=deepseek-flash   # or deepseek-v4-pro (stronger, pricier)
# DEEPSEEK_THINKING=off           # on = think before replying (slower)

# Claude
# ANTHROPIC_API_KEY=sk-ant-****
# ANTHROPIC_BASE_URL=          # only if you go through a proxy
# CLAUDE_MODEL=claude-opus-5-5
# CHAT_EFFORT=low

# ---- Memory (local SQLite, no cloud services) ----
# DB_PATH=data/companion.db
# RECENT_MESSAGES=20           # short-term memory window
# MEMORY_EXTRACTION=on         # set to off to stop saving long-term memories

# ---- Browser chat ----
# What the companion calls you in the browser debug chat
# WEB_USER_NAME=你

# ---- QQ via NapCat ----
# NAPCAT_HTTP_URL=http://127.0.0.1:3001
# QQ_TOKEN=                    # must match "token" in napcat/data/config/onebot11.json
# QQ_COMPANION=大肥鱼
# QQ_ALLOWED_USERS=12345678    # comma-separated QQ numbers; empty = anyone
# QQ_USER_NAMES=12345678:阿明   # what she calls each person; default = QQ nickname
# QQ_DEBOUNCE_MS=2000
# QQ_MAX_PIECES=3              # most QQ messages per reply (bursts get the bot account kicked)

# ---- Time zones ----
# COMPANION_TIMEZONE=Asia/Shanghai      # where she lives (her persona's city)
# USER_TIMEZONE=                        # default for everyone; empty = this computer's time zone
# QQ_USER_TIMEZONES=12345678:Asia/Tokyo,87654321:Asia/Shanghai   # per person

# ---- Growing up on her own ----
# SELF_GROWTH=on               # notes about herself -> periodic self-portrait (see /api/life)
# TRENDS=on                    # pull Bilibili/Baidu hot lists so she knows new memes
# TRENDS_REFRESH_HOURS=8

# ---- Free time (needs LLM_PROVIDER=deepseek) ----
# LIFE=on                      # she browses the web on her own between chats
# LIFE_INTERVAL_MINUTES=90     # average gap between free-time sessions (±50%)
# LIFE_SLEEP_HOURS=1-8         # her sleeping hours, her time zone
# LIFE_MAX_STEPS=16            # tool calls per session
# LIFE_MAX_MESSAGES_PER_DAY=1  # unprompted QQ messages per friend per day (0 = never)
# LIFE_CHATTY_FRIENDS=12345678 # QQ numbers she may message more often:
# LIFE_CHATTY_MAX_PER_DAY=4    #   up to this many a day
# LIFE_CHATTY_GAP_MINUTES=180  #   at least this long apart
# LIFE_TEMPERATURE=0.9

# ---- Offline alerts (bot QQ kicked offline / back online) ----
# SERVERCHAN_SENDKEY=          # Server酱 WeChat push, https://sct.ftqq.com
# BARK_URL=                    # Bark iPhone push, e.g. https://api.day.app/<key>

# ---- Stickers (collected while browsing / from friends, sent as [表情包:id]) ----
# STICKERS=on
# STICKERS_MAX=200             # oldest, least-used ones are dropped beyond this

# ---- 小黑盒 (her own account; log in with deploy/heybox-login.mjs) ----
# HEYBOX_COOKIE_FILE=data/heybox.json
# HEYBOX_COMMENTS_PER_DAY=3    # her own comments on posts; paused a day after a captcha / expired login
# HEYBOX_REPLIES_PER_DAY=5     # replies to people who answered her (each comment once)
# HEYBOX_POSTS_PER_DAY=1       # posts of her own
# HEYBOX_POST_TOPIC=7214       # community her posts go to (7214 = 盒友杂谈)
